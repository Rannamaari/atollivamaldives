APP_NAME="Atolliva Maldives"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Indian/Maldives

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=your-managed-db-host
DB_PORT=25060
DB_DATABASE=your_database_name
DB_USERNAME=your_database_user
DB_PASSWORD=replace-with-your-managed-db-password
DB_SSL_CA=/var/www/atolliva/storage/certs/digitalocean-managed-ca.pem
DB_SSL_VERIFY_SERVER_CERT=true

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public

MICRO_TRAVEL_WHATSAPP=9609996210
